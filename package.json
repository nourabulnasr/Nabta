{
  "name": "nabta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "audit:mobile": "node scripts/lighthouse.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "security:scan": "node scripts/security-scan.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "node scripts/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@vinext/cloudflare": "1.4.0",
    "aws4fetch": "1.0.20",
    "motion": "12.43.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "three": "0.184.0",
    "vinext": "1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.0",
    "@electric-sql/pglite": "0.5.8",
    "@netlify/plugin-nextjs": "5.15.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.184.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "lighthouse": "13.4.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "wrangler": "4.163.0"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "type": "module",
  "overrides": {
    "source-map-js": "1.2.2",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^5": "5.0.12",
    "fflate@^0.7": "0.7.5"
  }
}
