{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nabta",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/media/visuals/*"]
  },
  "keep_vars": true
}
