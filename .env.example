# Public canonical origin; rebuild after changes.
SITE_URL=https://nabta.nourabulnasr.workers.dev
SITE_INDEXABLE=false

# Private runtime secrets. Never add these to next.config env or NEXT_PUBLIC_*.
# Keep disabled until schema, email, owner MFA, private media and access tests are ready.
LEARNING_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# supabase for small files; r2 for longer recordings after owner activates storage.
RECORDING_STORAGE=supabase
R2_ACCOUNT_ID=
R2_BUCKET=nabta-recordings
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=


# Public site key passed only to the library. Enable its secret in Supabase Auth CAPTCHA.
TURNSTILE_SITE_KEY=
